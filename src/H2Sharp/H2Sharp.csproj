<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>H2Sharp</RootNamespace>
    <AssemblyName>H2Sharp</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Product>H2Sharp</Product>
    <Description>Embeddable SQL engine for .NET, ported from H2 Database.</Description>
    <Authors>The H2Sharp contributors</Authors>
    <Copyright>Copyright 2026 The H2Sharp contributors</Copyright>
    <PackageLicenseExpression>MPL-2.0 OR EPL-1.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/dimzon/h2sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dimzon/h2sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!--
      JavaScriptEncoder.TryEncodeUnicodeScalar is the one place H2's escaping rules can be handed
      to Utf8JsonWriter, and its signature uses char*. The alternative is hand-writing every
      string, which is what this replaced.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The engine is strong-named, so a friend has to be strong-named too and its public key has to
    be named here. The two test projects are signed with this project's own key; the Entity
    Framework Core provider is a separate project with a key of its own, and the key named here is
    the one it signs with.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="H2Sharp.Tests" Key="" />
    <InternalsVisibleTo Include="H2Sharp.JavaLegacy" Key="" />
    <InternalsVisibleTo Include="H2Sharp.Crypto" Key="" />
    <InternalsVisibleTo Include="H2Sharp.Native.Tests" Key="" />
    <InternalsVisibleTo Include="H2Sharp.Conformance" Key="" />
    <InternalsVisibleTo Include="H2Sharp.EntityFrameworkCore" Key="" />
  </ItemGroup>

  <!--
    H2's SQL error messages, copied verbatim from
    reference/h2/h2/src/main/org/h2/res/_messages_*.prop. They are the source of
    truth for Message/ErrorMessages.cs and must stay byte-identical to H2 so that
    error text matches. They are resources, not code, so they carry no H2 licence
    header; see NOTICE.md.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\_messages_*.prop" />
  </ItemGroup>

  <!--
    The package carries the readme and the licence it names: PackageReadmeFile and
    PackageLicenseExpression are only true if the files are in it.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE-H2.txt" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)..\..\NOTICE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>