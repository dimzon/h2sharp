<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console client for H2Sharp, analogous to the sqlite3 CLI: run SQL statements from
    the command line or interactively. This is a tool, not part of the engine package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>H2Sharp.Shell</AssemblyName>
    <RootNamespace>H2Sharp.Shell</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\H2Sharp\H2Sharp.csproj" />
  </ItemGroup>

</Project>